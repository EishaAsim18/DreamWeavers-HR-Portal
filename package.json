{
  "name": "dreamweavers-hrms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/database"
  ],
  "scripts": {
    "build": "npm run build --workspace @dreamweavers/database && npm run build --workspace @dreamweavers/api",
    "start": "npm run start --workspace @dreamweavers/api",
    "db:generate": "npm run db:generate --workspace @dreamweavers/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @dreamweavers/database",
    "db:seed": "npm run db:seed --workspace @dreamweavers/database"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
